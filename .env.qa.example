# Plantilla de .env.qa (ESPEC_credenciales_fuera.md). Copia este archivo a `.env.qa`
# (que está en .gitignore, nunca se versiona) y completa los valores contra tu Supabase
# LOCAL (`npx supabase start`, Docker) — nunca contra un proyecto real sin el sí de Christiam.
#
# Todas las claves quedan vacías a propósito: este archivo SÍ se versiona.

# ---- Conexión ----
QA_BASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Cuenta super_admin (qa_browser_test.js, qa_browser_test_v2.js, qa_full_e2e_execute.js) ----
QA_SUPERADMIN_DOC=
QA_SUPERADMIN_PIN=

# ---- Cuenta admin de institución (qa_browser_test*.js, qa_local_run_gpt.js, qa_full_e2e_execute.js) ----
QA_SCHOOLADMIN_DOC=
QA_SCHOOLADMIN_PIN=

# ---- Cuenta teacher (qa_browser_test*.js, qa_local_run_gpt.js) ----
QA_TEACHER_DOC=
QA_TEACHER_PIN=

# ---- Cuenta student (qa_local_run_gpt.js) ----
QA_STUDENT_DOC=
QA_STUDENT_PIN=

# ---- Cuentas propias de qa_full_e2e_execute.js (distintas de las de arriba) ----
QA_E2E_TEACHER_DOC=
QA_E2E_TEACHER_PIN=
QA_E2E_STUDENT_DOC=
QA_E2E_STUDENT_PIN=

# ---- PIN para cuentas QA nuevas que crea QA_CONTRACTUAL_FULL.ps1 (documento_id con timestamp) ----
QA_NEWACCOUNT_PIN=
